# Token du bot Discord (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=ton_token_ici

# ID de l'application Discord (Discord Developer Portal > General Information > Application ID)
CLIENT_ID=123456789012345678

# ID du serveur Discord (Clic droit sur le serveur > Copier l'identifiant)
GUILD_ID=123456789012345678

# Ton ID Discord (Clic droit sur ton profil > Copier l'identifiant)
OWNER_ID=123456789012345678

# ID du salon pour l'équipe Tryhard (Clic droit sur le salon > Copier l'identifiant)
CHANNEL_TRYHARD_ID=123456789012345678

# ID du salon pour l'équipe Fun (Clic droit sur le salon > Copier l'identifiant)
CHANNEL_FUN_ID=123456789012345678

# ID du rôle pour l'équipe Tryhard
ROLE_TRYHARD_ID=123456789012345678

# ID du rôle pour l'équipe Fun
ROLE_FUN_ID=123456789012345678
